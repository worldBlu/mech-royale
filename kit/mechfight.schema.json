{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://buildathon.local/mechfight-1.schema.json",
  "title": "mechfight/1",
  "description": "Every message of the mechfight/1 bot protocol (protocol.md). Server to bot: ServerMessage (hello, obs, end). Bot to server: BotMessage (ready, action). Unknown fields may be added later: ignore them.",
  "oneOf": [
    {
      "$ref": "#/definitions/ServerMessage"
    },
    {
      "$ref": "#/definitions/BotMessage"
    }
  ],
  "definitions": {
    "Action": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "action"
        },
        "tick": {
          "type": "number",
          "description": "echo the observation tick; stale answers are dropped"
        },
        "move": {
          "$ref": "#/definitions/Vec2",
          "description": "desired horizontal direction in world frame, length <= 1"
        },
        "boost": {
          "type": "boolean"
        },
        "jump": {
          "type": "boolean"
        },
        "aim": {
          "$ref": "#/definitions/Vec2",
          "description": "desired [yaw, pitch]; the torso slews toward it at turn_rate"
        },
        "fire": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "reload": {
          "type": "boolean"
        },
        "pick": {
          "type": "number",
          "description": "index into the current offer's choices"
        },
        "take": {
          "type": "number",
          "description": "id of a weapon pickup within loot.pickup_radius"
        },
        "drop": {
          "type": "number",
          "description": "slot (0/1) to empty: with `take`, the slot the new weapon replaces; alone, just drops it"
        },
        "debug": {
          "$ref": "#/definitions/DebugDraw",
          "description": "debug drawing, shown only to your team; never affects the match"
        }
      },
      "required": [
        "tick"
      ]
    },
    "ActorObs": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number"
        },
        "kind": {
          "type": "string",
          "enum": [
            "mech",
            "npc"
          ]
        },
        "pos": {
          "$ref": "#/definitions/Vec3"
        },
        "vel": {
          "$ref": "#/definitions/Vec3"
        },
        "aim": {
          "$ref": "#/definitions/Vec2"
        },
        "hp": {
          "type": "number"
        },
        "max_hp": {
          "type": "number"
        },
        "cubes": {
          "type": "number"
        },
        "weapons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WeaponKind"
          },
          "description": "weapons held (empty slots omitted)"
        },
        "charging": {
          "type": "boolean",
          "description": "laser charging (telegraph)"
        }
      },
      "required": [
        "id",
        "kind",
        "pos",
        "vel",
        "aim"
      ]
    },
    "BeamObs": {
      "type": "object",
      "properties": {
        "by": {
          "type": "number"
        },
        "kind": {
          "type": "string",
          "enum": [
            "laser",
            "lightning"
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Vec3"
          }
        },
        "age": {
          "type": "number"
        }
      },
      "required": [
        "by",
        "kind",
        "path",
        "age"
      ],
      "description": "an instant shot (laser beam or lightning arc) by another mech, from its muzzle along `path`"
    },
    "BotMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/Ready"
        },
        {
          "$ref": "#/definitions/Action"
        }
      ],
      "description": "Every message a bot sends the server."
    },
    "Color": {
      "type": "string",
      "description": "A color: \"#rgb\" or \"#rrggbb\". Anything else is replaced by your mech's color.",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "Config": {
      "type": "object",
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "bot": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "mech": {
          "$ref": "#/definitions/MechStats"
        },
        "vision": {
          "type": "object",
          "properties": {
            "range": {
              "type": "number"
            },
            "fov_deg": {
              "type": "number"
            },
            "near_range": {
              "type": "number"
            },
            "canopy_blocks": {
              "type": "boolean"
            },
            "show_enemy_hp": {
              "type": "boolean"
            },
            "memory_s": {
              "type": "number"
            }
          },
          "required": [
            "range",
            "fov_deg",
            "near_range",
            "canopy_blocks",
            "show_enemy_hp"
          ]
        },
        "sound": {
          "type": "object",
          "properties": {
            "bearing_noise_deg": {
              "type": "number"
            },
            "near": {
              "type": "number"
            },
            "mid": {
              "type": "number"
            },
            "step_speed": {
              "type": "number"
            },
            "step_every": {
              "type": "number"
            },
            "range": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": [
            "bearing_noise_deg",
            "near",
            "mid",
            "step_speed",
            "step_every",
            "range"
          ]
        },
        "weapons": {
          "type": "object",
          "properties": {
            "gun": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "mortar": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "laser": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "lightning": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": [
            "gun",
            "mortar",
            "laser",
            "lightning"
          ]
        },
        "projectile": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "cubes": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "properties": {
            "upgrade_thresholds": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "upgrade_thresholds"
          ]
        },
        "crates": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "loot": {
          "type": "object",
          "properties": {
            "pickup_radius": {
              "type": "number"
            },
            "equip_s": {
              "type": "number"
            },
            "floor_count": {
              "type": "number"
            },
            "floor_roof_fraction": {
              "type": "number"
            },
            "crate_weapon_chance": {
              "type": "number"
            },
            "death_drop": {
              "type": "number"
            },
            "weights": {
              "type": "object",
              "properties": {
                "gun": {
                  "type": "number"
                },
                "mortar": {
                  "type": "number"
                },
                "laser": {
                  "type": "number"
                },
                "lightning": {
                  "type": "number"
                }
              },
              "required": [
                "gun",
                "mortar",
                "laser",
                "lightning"
              ]
            }
          },
          "required": [
            "pickup_radius",
            "equip_s",
            "floor_count",
            "floor_roof_fraction",
            "crate_weapon_chance",
            "death_drop",
            "weights"
          ]
        },
        "npc": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "drops": {
          "type": "object",
          "properties": {
            "times": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "fall_s": {
              "type": "number"
            },
            "radius": {
              "type": "number"
            },
            "capture_s": {
              "type": "number"
            },
            "cubes": {
              "type": "number"
            },
            "repair": {
              "type": "number"
            },
            "spread": {
              "type": "number"
            }
          },
          "required": [
            "times",
            "fall_s",
            "radius",
            "capture_s",
            "cubes",
            "repair",
            "spread"
          ],
          "description": "Supply drops (optional: absent = none)."
        },
        "zone": {
          "type": "object",
          "properties": {
            "start_center": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "start_radius": {
              "type": "number"
            },
            "phases": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ZonePhase"
              }
            }
          },
          "required": [
            "start_center",
            "start_radius",
            "phases"
          ]
        },
        "replay": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "debug": {
          "$ref": "#/definitions/DebugCaps",
          "description": "Caps on action.debug: the server silently cuts each decision's drawing to these."
        },
        "upgrades": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UpgradeDef"
          }
        }
      },
      "required": [
        "match",
        "bot",
        "mech",
        "vision",
        "sound",
        "weapons",
        "projectile",
        "cubes",
        "crates",
        "loot",
        "npc",
        "zone",
        "replay",
        "debug",
        "upgrades"
      ]
    },
    "DamagedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "damaged"
        },
        "amount": {
          "type": "number"
        },
        "weapon": {
          "type": "string",
          "description": "gun, mortar, laser, lightning, npc or zone"
        },
        "bearing": {
          "type": [
            "number",
            "null"
          ],
          "description": "world-frame yaw toward the source (null for the zone)"
        },
        "by": {
          "type": [
            "number",
            "null"
          ],
          "description": "attacker id (null for the zone)"
        },
        "rear": {
          "type": "boolean",
          "description": "it came from outside your front arc (x mech.rear_mult)"
        }
      },
      "required": [
        "type",
        "amount",
        "weapon",
        "bearing",
        "by"
      ],
      "description": "You took damage."
    },
    "DebugCaps": {
      "type": "object",
      "properties": {
        "max_lines": {
          "type": "number"
        },
        "max_points": {
          "type": "number"
        },
        "max_text": {
          "type": "number"
        },
        "max_text_chars": {
          "type": "number"
        },
        "max_bytes": {
          "type": "number"
        },
        "max_match_bytes": {
          "type": "number"
        },
        "hold_s": {
          "type": "number"
        }
      },
      "required": [
        "max_lines",
        "max_points",
        "max_text",
        "max_text_chars",
        "max_bytes",
        "max_match_bytes",
        "hold_s"
      ],
      "description": "Caps on the debug drawing a bot may attach to an action."
    },
    "DebugDraw": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DebugLine"
          }
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DebugPoint"
          }
        },
        "text": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DebugText"
          }
        },
        "label": {
          "type": "string",
          "description": "one short status line drawn above your mech"
        }
      },
      "description": "Debug drawing for one decision. Stays on screen until your next decision that carries `debug`, or `debug.hold_s` seconds, whichever comes first; send `{}` to clear it early. The server truncates to the `[debug]` caps in hello.config (item counts, text length, bytes per decision, bytes per match) without telling you. It is recorded to a file only your team can download, never to the public replay, and has no effect on the match."
    },
    "DebugLine": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/definitions/Vec3"
        },
        "b": {
          "$ref": "#/definitions/Vec3"
        },
        "color": {
          "$ref": "#/definitions/Color"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "description": "A line segment from world point `a` to `b` (x east, y north, z up, meters)."
    },
    "DebugPoint": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/definitions/Vec3"
        },
        "color": {
          "$ref": "#/definitions/Color"
        },
        "size": {
          "type": "number"
        }
      },
      "required": [
        "at"
      ],
      "description": "A dot at a world point. `size` is its radius in screen pixels (1..12, default 4)."
    },
    "DebugText": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "at": {
          "$ref": "#/definitions/Vec3"
        },
        "color": {
          "$ref": "#/definitions/Color"
        }
      },
      "required": [
        "text"
      ],
      "description": "A text label. With `at`, drawn at that world point; without, stacked above your mech."
    },
    "DropEvent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "drop"
        },
        "id": {
          "type": "number"
        },
        "cubes": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "id",
        "cubes"
      ],
      "description": "You captured supply drop `id`; `cubes` is your new total."
    },
    "DropObs": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number"
        },
        "pos": {
          "$ref": "#/definitions/Vec3"
        },
        "radius": {
          "type": "number",
          "description": "stand inside this, alone, for capture_s"
        },
        "lands_in": {
          "type": "number",
          "description": "seconds until it can be captured (0 = on the ground)"
        },
        "capture_s": {
          "type": "number"
        },
        "progress": {
          "type": "number",
          "description": "seconds the current holder has banked"
        },
        "holder": {
          "type": [
            "number",
            "null"
          ],
          "description": "mech currently capturing"
        }
      },
      "required": [
        "id",
        "pos",
        "radius",
        "lands_in",
        "capture_s",
        "progress",
        "holder"
      ],
      "description": "A supply drop. Known to every mech from the moment it is called, like the zone."
    },
    "DroppedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "dropped"
        },
        "id": {
          "type": "number"
        },
        "kind": {
          "$ref": "#/definitions/WeaponKind"
        },
        "slot": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "id",
        "kind",
        "slot"
      ],
      "description": "A weapon left your `slot` and lies on the ground as pickup `id`."
    },
    "Effect": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "mul": {
          "type": "number"
        },
        "add": {
          "type": "number"
        }
      },
      "required": [
        "path"
      ]
    },
    "EffectEvent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "effect"
        },
        "effect": {
          "$ref": "#/definitions/EffectName"
        },
        "by": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "effect",
        "by"
      ],
      "description": "A signature effect landed on you."
    },
    "EffectName": {
      "type": "string",
      "enum": [
        "cookoff",
        "short",
        "concuss"
      ],
      "description": "cookoff: laser on a mortar carrier. short: lightning on a laser carrier. concuss: any mortar blast."
    },
    "EndMsg": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "end"
        },
        "place": {
          "type": "number"
        },
        "kills": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "place",
        "kills"
      ]
    },
    "GameEvent": {
      "anyOf": [
        {
          "$ref": "#/definitions/DamagedEvent"
        },
        {
          "$ref": "#/definitions/HitEvent"
        },
        {
          "$ref": "#/definitions/EffectEvent"
        },
        {
          "$ref": "#/definitions/DropEvent"
        },
        {
          "$ref": "#/definitions/KillEvent"
        },
        {
          "$ref": "#/definitions/PickupEvent"
        },
        {
          "$ref": "#/definitions/UpgradeEvent"
        },
        {
          "$ref": "#/definitions/TookEvent"
        },
        {
          "$ref": "#/definitions/DroppedEvent"
        },
        {
          "$ref": "#/definitions/TakeFailedEvent"
        }
      ]
    },
    "Hello": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "protocol": {
          "type": "string",
          "const": "mechfight/1"
        },
        "slot": {
          "type": "number",
          "description": "your mech id, 0..15"
        },
        "seed": {
          "type": "number",
          "description": "per-bot seed, use it for your own RNG to stay reproducible"
        },
        "map": {
          "type": "object",
          "properties": {
            "dir": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "dir",
            "files"
          ]
        },
        "config": {
          "$ref": "#/definitions/Config"
        }
      },
      "required": [
        "type",
        "protocol",
        "slot",
        "seed",
        "map",
        "config"
      ]
    },
    "HitEvent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hit"
        },
        "target": {
          "type": "number"
        },
        "amount": {
          "type": "number"
        },
        "weapon": {
          "type": "string"
        },
        "effect": {
          "$ref": "#/definitions/EffectName"
        },
        "rear": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "target",
        "amount",
        "weapon"
      ],
      "description": "You damaged `target` (a mech, NPC or crate id)."
    },
    "ItemObs": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number"
        },
        "pos": {
          "$ref": "#/definitions/Vec3"
        },
        "hp": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "pos"
      ]
    },
    "KillEvent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "kill"
        },
        "target": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "description": "You killed a mech."
    },
    "MechStats": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "Observation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "obs"
        },
        "tick": {
          "type": "number"
        },
        "t": {
          "type": "number",
          "description": "match time, seconds"
        },
        "alive": {
          "type": "number",
          "description": "mechs alive (not NPCs)"
        },
        "self": {
          "$ref": "#/definitions/SelfObs"
        },
        "mechs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ActorObs"
          },
          "description": "visible mechs and NPCs"
        },
        "projectiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProjectileObs"
          }
        },
        "crates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemObs"
          }
        },
        "cubes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemObs"
          }
        },
        "pickups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PickupObs"
          },
          "description": "visible weapons on the ground"
        },
        "sounds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SoundObs"
          }
        },
        "beams": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BeamObs"
          },
          "description": "laser beams and lightning arcs by other mechs that you saw (any point of the path in view) since your last observation"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GameEvent"
          }
        },
        "zone": {
          "$ref": "#/definitions/ZoneObs"
        },
        "offer": {
          "anyOf": [
            {
              "$ref": "#/definitions/Offer"
            },
            {
              "type": "null"
            }
          ]
        },
        "drops": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DropObs"
          },
          "description": "supply drops called or on the ground"
        }
      },
      "required": [
        "type",
        "tick",
        "t",
        "alive",
        "self",
        "mechs",
        "projectiles",
        "crates",
        "cubes",
